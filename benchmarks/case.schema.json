{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/palasht75/dunnit/main/benchmarks/case.schema.json",
  "title": "Dunnit benchmark case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "protocol",
    "ecosystem",
    "class",
    "category",
    "fixture",
    "fixture_sha256",
    "operating_systems",
    "topology",
    "expected",
    "rationale",
    "license"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"
    },
    "protocol": {
      "const": "dunnit-benchmark-v1"
    },
    "ecosystem": {
      "enum": [
        "python",
        "javascript-typescript",
        "go",
        "rust",
        "jvm",
        "ruby",
        "csharp",
        "php",
        "mixed"
      ]
    },
    "class": {
      "enum": ["adversarial", "benign"]
    },
    "category": {
      "enum": [
        "trust-fail-closed",
        "deleted-renamed-tests",
        "skip-focus",
        "assertion-weakening",
        "test-deselection",
        "stub-suppression",
        "command-integrity",
        "normal-strengthening",
        "marker-context",
        "legitimate-config",
        "declared-writes",
        "unusual-path",
        "topology-line-endings"
      ]
    },
    "fixture": {
      "type": "string",
      "allOf": [
        {
          "pattern": "^fixtures/[^/\\\\\\u0000]+(?:/[^/\\\\\\u0000]+)*$"
        },
        {
          "not": {
            "pattern": "(?:^|/)\\.\\.?(?:/|$)"
          }
        }
      ]
    },
    "fixture_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "operating_systems": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["linux", "windows", "macos"]
      }
    },
    "topology": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "normal",
          "spaces",
          "unicode",
          "tabs",
          "lf",
          "crlf",
          "binary",
          "oversized",
          "shallow-sufficient",
          "shallow-missing-history",
          "detached-head",
          "unborn",
          "worktree",
          "monorepo",
          "committed",
          "staged",
          "unstaged",
          "untracked",
          "many-untracked"
        ]
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "findings", "paths_complete", "content_complete"],
      "properties": {
        "outcome": {
          "enum": ["pass", "pass_with_warnings", "fail", "error"]
        },
        "findings": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/expectedFinding"
          }
        },
        "forbidden_rule_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "paths_complete": {"type": "boolean"},
        "content_complete": {"type": "boolean"}
      }
    },
    "rationale": {"type": "string", "minLength": 1},
    "license": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "class": {"const": "adversarial"}
        },
        "required": ["class"]
      },
      "then": {
        "properties": {
          "category": {
            "enum": [
              "trust-fail-closed",
              "deleted-renamed-tests",
              "skip-focus",
              "assertion-weakening",
              "test-deselection",
              "stub-suppression",
              "command-integrity"
            ]
          },
          "expected": {
            "properties": {
              "outcome": {
                "enum": ["pass_with_warnings", "fail", "error"]
              },
              "findings": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "class": {"const": "benign"}
        },
        "required": ["class"]
      },
      "then": {
        "properties": {
          "category": {
            "enum": [
              "normal-strengthening",
              "marker-context",
              "legitimate-config",
              "declared-writes",
              "unusual-path",
              "topology-line-endings"
            ]
          },
          "expected": {
            "required": ["forbidden_rule_ids"],
            "properties": {
              "outcome": {"const": "pass"},
              "findings": {"maxItems": 0},
              "forbidden_rule_ids": {"minItems": 1}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "category": {
            "enum": ["trust-fail-closed", "test-deselection", "command-integrity"]
          }
        },
        "required": ["category"]
      },
      "then": {
        "properties": {
          "expected": {
            "properties": {
              "outcome": {
                "enum": ["fail", "error"]
              },
              "findings": {
                "contains": {
                  "type": "object",
                  "required": ["severity"],
                  "properties": {
                    "severity": {"const": "error"}
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "allOf": [
        {
          "pattern": "^(?![A-Za-z]:)[^/\\\\\\u0000]+(?:/[^/\\\\\\u0000]+)*$"
        },
        {
          "not": {
            "pattern": "(?:^|/)\\.\\.?(?:/|$)"
          }
        }
      ]
    },
    "expectedFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "severity", "path"],
      "properties": {
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": ["warning", "error"]
        },
        "path": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/repositoryPath"}
          ]
        }
      }
    }
  }
}
